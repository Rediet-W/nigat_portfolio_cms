{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "SEO",
    "icon": "search",
    "description": "Search engine and social sharing metadata"
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "maxLength": 70,
      "description": "Browser tab / Google title (≤ 60 characters recommended)"
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 200,
      "description": "Google snippet (150–160 characters recommended)"
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "description": "Image shown when the page is shared (1200×630)"
    },
    "noIndex": {
      "type": "boolean",
      "default": false
    }
  }
}
