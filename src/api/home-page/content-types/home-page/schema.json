{
  "kind": "collectionType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home Page",
    "description": "Home page hero and highlights — exactly one entry per sector."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "sector": {
      "type": "enumeration",
      "enum": [
        "construction",
        "motors",
        "exports"
      ],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "description": "Which Nigat sector website shows this entry",
      "unique": true
    },
    "heroBadge": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "heroSubtitle": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroSlides": {
      "type": "component",
      "component": "home.hero-slide",
      "repeatable": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "heroSlideDuration": {
      "type": "integer",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "default": 7000,
      "min": 2000,
      "description": "Milliseconds each slide stays on screen"
    },
    "primaryCta": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "secondaryCta": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "highlights": {
      "type": "component",
      "component": "shared.feature",
      "repeatable": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "stats": {
      "type": "component",
      "component": "shared.stat",
      "repeatable": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
