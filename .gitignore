.tmp/
*.db
*.sqlite
*.sqlite3
public/uploads/*
!public/uploads/.gitkeep

# Logs
*.log
logs/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
