# Dependencies
node_modules/

# Environment — secrets never go to git (.env.example does)
.env
.env.*
!.env.example

# Build output and Strapi caches
dist/
build/
.strapi/
.cache/
.strapi-updater.json
.strapi-cloud.json
*.tsbuildinfo

