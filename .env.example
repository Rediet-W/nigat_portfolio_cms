# ─────────────────────────────────────────────────────────────
# Nigat Portfolio CMS — environment variables
# Copy to .env and fill in. See README → "Environment variables"
# for where each value comes from.
# ─────────────────────────────────────────────────────────────

# Server
HOST=0.0.0.0
PORT=1337
# Public URL of the CMS, e.g. https://cms.nigat.et (no trailing slash)
PUBLIC_URL=http://localhost:1337
# true when running behind Azure / a reverse proxy that terminates HTTPS
IS_PROXIED=false

# Secrets — generate each with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS takes 4 comma-separated values.
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database — PostgreSQL everywhere.
# The defaults match the local Docker database (docker compose up -d).
# For staging/production use the managed server's values, or one DATABASE_URL.
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=nigat_cms
DATABASE_USERNAME=nigat
DATABASE_PASSWORD=nigat
DATABASE_SSL=false

# Cloudinary media storage (leave empty to store files on disk)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
CLOUDINARY_FOLDER=nigat-cms

# Websites allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:3000,https://nigat-construction.vercel.app,https://nigat-motors.vercel.app,https://nigat-exports.vercel.app

# On-demand revalidation — each website's revalidate endpoint.
# Leave a URL empty to skip that website. Same secret goes in each website's env.
REVALIDATE_SECRET=tobemodified
REVALIDATE_URL_CONSTRUCTION=
REVALIDATE_URL_MOTORS=
REVALIDATE_URL_EXPORTS=
